# demo: entorno público poblado con información ficticia
# private: entorno protegido con Supabase Auth y base de datos aislada
VITE_APP_MODE=demo

VITE_PRODUCT_NAME=Sistema Administrativo de Arriendos

# Solo son obligatorias en VITE_APP_MODE=private.
# La anon key de Supabase puede estar en el frontend; la protección real depende de RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
